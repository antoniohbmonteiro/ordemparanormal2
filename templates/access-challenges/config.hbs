<section class="op2-access__body op2-access__config-body" data-challenge-type="{{#if isUnlock}}unlock{{else}}break{{/if}}" data-wide="{{wide}}">
  <label class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Participant'}}</span>
    <div class="op2-access__identity op2-access__config-identity"><img class="op2-access__portrait" src="{{participantImg}}" alt="" />
      <select name="participant" data-config-field aria-label="{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.ParticipantAria'}}">
        {{#each participantOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{else}}<option value="">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.NoAgent'}}</option>{{/each}}
      </select>
    </div>
  </label>
  <label class="op2-access__field"><span>{{#if isUnlock}}{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.OptionalObstacle'}}{{else}}{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Obstacle'}}{{/if}}</span><input name="obstacle" data-config-field type="text" value="{{obstacle}}" {{#if isBreak}}placeholder="{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.ObstaclePlaceholder'}}"{{/if}} /></label>
  {{#if isUnlock}}
    <div class="op2-access__field-row">
      <label class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Complexity'}}</span><div class="op2-access__inline">
        <select name="diceCount" data-config-field>{{#each diceCountOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select>
        <select name="die" data-config-field>{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </div></label>
      <label class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Resistance'}}</span><input name="resistance" data-config-field type="number" min="1" step="1" value="{{resistance}}" /></label>
    </div>
    <div class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.SecretGeneration'}}</span><div class="op2-access__mode" role="group" aria-label="{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.SecretGenerationAria'}}">
      <button type="button" data-action="selectMode" data-mode="random" aria-pressed="{{random}}">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Random'}}</button>
      <button type="button" data-action="selectMode" data-mode="manual" aria-pressed="{{manual}}">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Manual'}}</button>
    </div></div>
    {{#if manual}}<div class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.ManualSecret' diceCount=diceCount die=die}}</span><div class="op2-access__secret-inputs">
      {{#each secretSlots}}<select data-secret-slot aria-label="{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Slot' position=label}}"><option value="">—</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select>{{/each}}
    </div></div>{{/if}}
  {{/if}}
  {{#if isBreak}}
    <div class="op2-access__field-row"><label class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Difficulty'}}</span><input name="difficulty" data-config-field type="number" min="1" step="1" value="{{difficulty}}" /></label>
      <label class="op2-access__field"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Fields.Pa'}}</span><input name="pa" data-config-field type="number" min="1" step="1" value="{{pa}}" /></label></div>
    <p class="op2-access__hint">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.SkillHint'}}<br />{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.CostHint'}}</p>
  {{/if}}
  {{#if error}}<p class="op2-access__error" role="alert">{{error}}</p>{{/if}}
  <div class="op2-access__config-actions"><button class="op2-access__secondary" type="button" data-action="cancel">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.Cancel'}}</button>
    <button class="op2-access__primary" type="button" data-action="submit" {{#unless canStart}}disabled{{/unless}}>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.Start'}}</button></div>
</section>
