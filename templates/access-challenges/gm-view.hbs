<section class="op2-access__body" data-challenge-type="{{challengeType}}" data-status="{{status}}" data-wide="{{wide}}" data-terminal="{{terminal}}">
  <div class="op2-access__identity">{{#if isBreak}}<img class="op2-access__avatar-dot" src="systems/ordemparanormal2/assets/icons/access-challenges/avatar-dot.svg" alt="" />{{else}}<img class="op2-access__portrait" src="{{participantImg}}" alt="" />{{/if}}
    <strong>{{participantName}}</strong>{{#if isUnlock}}<span class="op2-access__crime">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Crime' die=unlock.crimeDie}}</span>{{/if}}</div>
  <hr class="op2-access__divider" />
  {{#if isUnlock}}
    <div class="op2-access__secret"><small>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Secret'}}</small><div class="op2-access__secret-row">
      <div class="op2-access__secret-values">{{#each unlock.secret}}<b>{{this}}</b>{{/each}}</div>
      <div class="op2-access__secret-counts"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.RoundAttempts' used=unlock.attemptsThisRound total=unlock.attemptsPerRound}}</span><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.TotalAttempts' used=unlock.attemptsUsed total=unlock.resistance}}</span></div>
    </div></div>
    <div class="op2-access__section"><h3 class="op2-access__section-title">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.History'}}</h3><div class="op2-access__history">
      {{#each unlock.history}}<article class="op2-access__history-entry"><div class="op2-access__history-heading"><strong>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Attempt' number=number}}</strong><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Round' round=round}}</span></div>
        <div class="op2-access__mini-slots">{{#each slots}}<div class="op2-access__mini-slot op2-access__mini-slot--{{feedback}}"><b>{{value}}</b>
          <span class="op2-access__feedback op2-access__feedback--{{feedback}}"><span aria-hidden="true">{{feedbackSymbol}}</span>{{feedbackLabel}}</span></div>{{/each}}</div>
      </article>{{else}}<p class="op2-access__muted">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.AwaitingFirstAttempt'}}</p>{{/each}}
    </div></div>
    {{#if unlock.success}}<div class="op2-access__notice op2-access__notice--success"><strong>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Unlock.SuccessTitle'}}</strong><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Unlock.SuccessDescriptionGm'}}</span></div>{{/if}}
    {{#if unlock.jammed}}<div class="op2-access__notice op2-access__notice--danger"><strong>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Unlock.JammedTitle'}}</strong><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Unlock.JammedDescriptionGm'}}</span></div>{{/if}}
    {{#if canCancel}}<div class="op2-access__gm-actions"><button class="{{#if unlock.canAdvance}}op2-access__primary{{else}}op2-access__advance-pending{{/if}}" data-action="advanceRound" type="button" {{#unless unlock.canAdvance}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.AdvanceRound' round=unlock.nextRound}}</button>
      <button class="op2-access__text-button" type="button" data-action="cancelChallenge" {{#if busy}}disabled{{/if}}>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.CancelChallenge'}}</button></div>{{/if}}
  {{/if}}
  {{#if isBreak}}
    <div class="op2-access__section"><h3 class="op2-access__section-title">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Information'}}</h3><div class="op2-access__break-info">
      <strong class="op2-access__obstacle-name">{{obstacle}}</strong>
      <div class="op2-access__chips"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.Athletics'}}</span><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.DifficultyTag' difficulty=break.difficulty}}</span><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.CostTagGm'}}</span></div>
    </div></div>
    <div class="op2-access__progress"><div class="op2-access__resistance-label"><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.RemainingUpper'}}</span><b>{{break.remaining}} / {{break.pa}}</b></div>
      <div class="op2-access__bar"><span style="width: {{break.percentage}}%"></span></div></div>
    {{#if break.completed}}<div class="op2-access__notice op2-access__notice--success"><strong>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.CompletedTitle'}}</strong><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.CompletedDescription'}}</span></div>{{/if}}
    <div class="op2-access__section"><h3 class="op2-access__section-title">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.History'}}</h3><div class="op2-access__history">
      {{#each break.history}}<article class="op2-access__break-entry {{#if success}}op2-access__break-entry--success{{else}}op2-access__break-entry--failure{{/if}}">
        <div class="op2-access__break-entry-content"><div class="op2-access__history-heading"><strong>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.Attempt' number=number}}</strong><b>{{remaining}} / {{../break.pa}}</b></div>
          <div class="op2-access__history-heading"><span class="op2-access__feedback {{#if success}}op2-access__feedback--exact{{else}}op2-access__feedback--low{{/if}}">{{#if success}}{{localize 'ORDEMPARANORMAL2.AccessChallenges.Feedback.Success'}}{{else}}{{localize 'ORDEMPARANORMAL2.AccessChallenges.Feedback.Failure'}}{{/if}}</span><span>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Break.AddedRA' ra=addedRA}}</span></div></div>
        <div class="op2-access__bar"><span style="width: {{percentage}}%"></span></div>
      </article>{{else}}<p class="op2-access__muted">{{localize 'ORDEMPARANORMAL2.AccessChallenges.Gm.AwaitingFirstAttempt'}}</p>{{/each}}
    </div></div>
    {{#if canCancel}}<div class="op2-access__break-actions"><button class="op2-access__secondary" type="button" data-action="cancelChallenge" {{#if busy}}disabled{{/if}}>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.CancelChallenge'}}</button></div>
    {{else}}<button class="op2-access__text-button" type="button" data-action="cancelChallenge" disabled>{{localize 'ORDEMPARANORMAL2.AccessChallenges.Actions.CancelChallenge'}}</button>{{/if}}
  {{/if}}
</section>
