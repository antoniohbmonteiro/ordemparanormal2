<section class="op2-abilities" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Tabs.Abilities'}}">
  <h2 class="op2-abilities__title">{{localize "ORDEMPARANORMAL2.AgentSheet.Tabs.Abilities"}}</h2>
  <div class="op2-abilities__heading">{{localize "ORDEMPARANORMAL2.AgentSheet.Abilities.Subtitle"}}</div>
  <div class="op2-abilities__list">
    {{#each agent.abilities}}
      <article class="op2-ability-card" data-item-id="{{id}}">
        <div class="op2-ability-card__header">
          <button class="op2-ability-card__use" type="button" data-action="useAbility" data-item-id="{{id}}" aria-label="{{name}}"{{#unless @root.editable}} disabled{{/unless}}>
            <span class="op2-ability-card__image">
              <img src="{{img}}" alt="" />
              <span class="op2-ability-card__use-label" aria-hidden="true">{{localize "ORDEMPARANORMAL2.AgentSheet.Abilities.Use"}}</span>
            </span>
            <span class="op2-ability-card__body">
              <span class="op2-ability-card__name">{{name}}</span>
              <span class="op2-ability-card__subtitle">{{localize "ORDEMPARANORMAL2.AgentSheet.Abilities.Subtitle"}}</span>
            </span>
          </button>
          {{#if resource}}
            <div class="op2-ability-card__resource">
              <span class="op2-ability-card__resource-value">{{resource.value}} / {{resource.max}}</span>
              <span class="op2-ability-card__resource-track" role="meter" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.Resource'}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{resource.fillPercentage}}" aria-valuetext="{{resource.value}} / {{resource.max}}">
                <span class="op2-ability-card__resource-fill" style="width: {{resource.fillPercentage}}%;"></span>
              </span>
              {{#if @root.editable}}
                <div class="op2-ability-card__resource-controls">
                  <button class="op2-ability-card__resource-adjust" type="button" data-action="decreaseAbilityResource" data-resource-adjustment="decrease" data-item-id="{{id}}" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.DecreaseResource'}}"{{#unless resource.canDecrease}} disabled{{/unless}}>−</button>
                  <span class="op2-ability-card__resource-current" aria-hidden="true">
                    <span class="op2-ability-card__resource-value">{{resource.value}} / {{resource.max}}</span>
                    <span class="op2-ability-card__resource-track"><span class="op2-ability-card__resource-fill" style="width: {{resource.fillPercentage}}%;"></span></span>
                  </span>
                  <button class="op2-ability-card__resource-adjust" type="button" data-action="increaseAbilityResource" data-resource-adjustment="increase" data-item-id="{{id}}" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.IncreaseResource'}}"{{#unless resource.canIncrease}} disabled{{/unless}}>+</button>
                </div>
              {{/if}}
            </div>
          {{/if}}
          {{#if @root.canEditStructure}}
            <button class="op2-ability-card__menu-trigger" type="button" data-item-id="{{id}}" aria-haspopup="menu" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.Actions'}}" title="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.Actions'}}"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></button>
          {{else}}
            <button class="op2-ability-card__expand" type="button" data-action="toggleAbilityDescription" data-item-id="{{id}}" aria-expanded="{{isExpanded}}" aria-controls="{{detailsId}}" aria-label="{{localize 'ORDEMPARANORMAL2.AgentSheet.Abilities.ToggleDescription'}}"><span aria-hidden="true">{{#if isExpanded}}▾{{else}}▸{{/if}}</span></button>
          {{/if}}
        </div>
        <div class="op2-ability-card__details" id="{{detailsId}}"{{#unless isExpanded}} hidden{{/unless}}>
          {{#if descriptionHTML}}<div class="op2-ability-card__description">{{{descriptionHTML}}}</div>{{/if}}
          {{#if useForms.length}}
            <h3 class="op2-ability-card__forms-title">{{localize "ORDEMPARANORMAL2.AgentSheet.Abilities.UseForms"}}</h3>
            <ul class="op2-ability-card__forms">
              {{#each useForms}}
                <li class="op2-ability-card__form">
                  <span class="op2-ability-card__form-name">{{name}}</span>
                  {{#if isCheckIntegrated}}<span class="op2-ability-card__check-label">{{localize "ORDEMPARANORMAL2.AgentSheet.Abilities.CheckOnly"}}</span>{{/if}}
                  {{#if descriptionHTML}}<div class="op2-ability-card__description">{{{descriptionHTML}}}</div>{{/if}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
        </div>
      </article>
    {{else}}
      <p class="op2-empty-state">{{localize "ORDEMPARANORMAL2.AgentSheet.Placeholders.Abilities"}}</p>
    {{/each}}
  </div>
</section>
