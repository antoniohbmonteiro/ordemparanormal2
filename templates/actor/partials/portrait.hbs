<div class="op2-portrait">
  <img src="{{image}}" alt="{{localize altKey}}"{{#if editable}} data-edit="img" data-action="editImage" title="{{localize editKey}}"{{/if}}>
  {{#if editable}}<button class="op2-portrait__edit" type="button" data-portrait-trigger aria-label="{{localize editKey}}" title="{{localize editKey}}"><i class="fa-solid fa-camera" aria-hidden="true"></i></button>{{/if}}
</div>
