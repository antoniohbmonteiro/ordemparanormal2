<div class="op2-adventure-import__body">
  <aside class="op2-adventure-import__notice">
    <p>{{localize "ORDEMPARANORMAL2.AdventureImport.Notice.Ownership"}}</p>
    <p>{{localize "ORDEMPARANORMAL2.AdventureImport.Notice.LocalProcessing"}}</p>
  </aside>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-main-heading">
    <h2 id="op2-adventure-import-main-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.MainMaterial"}}</h2>
    <div class="op2-adventure-import__file-row">
      <span class="op2-adventure-import__file-label">{{localize "ORDEMPARANORMAL2.AdventureImport.PlaytestPdf"}}</span>
      <button type="button" data-action="selectPdf" {{#if isImporting}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.SelectPdf"}}</button>
      <input type="file" accept=".pdf" data-file-slot="pdf" hidden />
      <span class="op2-adventure-import__file-empty{{#if pdfName}} op2-adventure-import__file-selected{{/if}}">
        {{#if pdfName}}<span class="op2-adventure-import__selection-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span><span class="op2-adventure-import__file-name">{{pdfName}}</span>{{else}}{{localize "ORDEMPARANORMAL2.AdventureImport.EmptyFile"}}{{/if}}
      </span>
    </div>
  </section>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-extras-heading">
    <h2 id="op2-adventure-import-extras-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.ExtrasByAct"}}</h2>
    <div class="op2-adventure-import__file-list">
      <div class="op2-adventure-import__file-row">
        <span class="op2-adventure-import__file-label">{{localize "ORDEMPARANORMAL2.AdventureImport.ActOne"}}</span>
        <button type="button" data-action="selectZip" data-file-slot="actOne" {{#if isImporting}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.SelectZip"}}</button>
        <input type="file" accept=".zip" data-file-slot="actOne" hidden />
        <span class="op2-adventure-import__file-empty{{#if actOneName}} op2-adventure-import__file-selected{{/if}}">
          {{#if actOneName}}<span class="op2-adventure-import__selection-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span><span class="op2-adventure-import__file-name">{{actOneName}}</span>{{else}}{{localize "ORDEMPARANORMAL2.AdventureImport.EmptyFile"}}{{/if}}
        </span>
      </div>
      <div class="op2-adventure-import__file-row">
        <span class="op2-adventure-import__file-label">{{localize "ORDEMPARANORMAL2.AdventureImport.ActTwo"}}</span>
        <button type="button" data-action="selectZip" data-file-slot="actTwo" {{#if isImporting}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.SelectZip"}}</button>
        <input type="file" accept=".zip" data-file-slot="actTwo" hidden />
        <span class="op2-adventure-import__file-empty{{#if actTwoName}} op2-adventure-import__file-selected{{/if}}">
          {{#if actTwoName}}<span class="op2-adventure-import__selection-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span><span class="op2-adventure-import__file-name">{{actTwoName}}</span>{{else}}{{localize "ORDEMPARANORMAL2.AdventureImport.EmptyFile"}}{{/if}}
        </span>
      </div>
    </div>
  </section>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-detected-heading">
    <h2 id="op2-adventure-import-detected-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.DetectedContent"}}</h2>
    {{#if hasAnalysis}}
      <div class="op2-adventure-import__analysis">
        {{#with pdfStatus}}
          <div class="op2-adventure-import__status-row op2-adventure-import__status-row--{{modifier}}">
            <span class="op2-adventure-import__status-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
            <span class="op2-adventure-import__status-text">
              <span class="op2-adventure-import__status-label">{{label}}</span>
              <span class="op2-adventure-import__status-value">{{text}}</span>
              {{#each issues}}<span class="op2-adventure-import__status-issue">{{this}}</span>{{/each}}
            </span>
          </div>
        {{/with}}
        {{#if actCards.length}}
          <div class="op2-adventure-import__act-cards">
            {{#each actCards}}
              <article class="op2-adventure-import__act-card" aria-label="{{label}}">
                <h3 class="op2-adventure-import__act-title">{{label}}</h3>
                <p class="op2-adventure-import__act-status"><i class="fa-solid fa-check" aria-hidden="true"></i>{{status}}</p>
                <div class="op2-adventure-import__act-content">
                  {{#each content}}
                    <div class="op2-adventure-import__act-content-row">
                      <i class="op2-adventure-import__act-content-icon {{icon}}" aria-hidden="true"></i>
                      <span class="op2-adventure-import__act-content-label">{{label}}</span>
                      <span class="op2-adventure-import__act-content-count">{{count}}</span>
                    </div>
                  {{/each}}
                </div>
              </article>
            {{/each}}
          </div>
        {{/if}}
        {{#each otherStatuses}}
          <div class="op2-adventure-import__status-row op2-adventure-import__status-row--{{modifier}}">
            <span class="op2-adventure-import__status-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
            <span class="op2-adventure-import__status-text">
              <span class="op2-adventure-import__status-label">{{label}}</span>
              <span class="op2-adventure-import__status-value">{{text}}</span>
              {{#each issues}}<span class="op2-adventure-import__status-issue">{{this}}</span>{{/each}}
            </span>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="op2-adventure-import__empty-content">
        {{localize "ORDEMPARANORMAL2.AdventureImport.EmptyContent"}}
      </div>
    {{/if}}
  </section>

  <footer class="op2-adventure-import__actions">
    {{#if progress}}<p class="op2-adventure-import__progress" role="status" aria-live="polite">{{progress}}</p>{{/if}}
    <button type="button" data-action="analyzeFiles" {{#unless canAnalyze}}disabled{{/unless}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.Analyze"}}</button>
    <button type="button" data-action="importAssets" {{#unless canImport}}disabled{{/unless}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.Import"}}</button>
  </footer>
</div>
