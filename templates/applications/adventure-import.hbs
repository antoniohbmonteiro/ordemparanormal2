<div class="op2-adventure-import__body">
  {{> "systems/ordemparanormal2/templates/actor/partials/content-tabs.hbs" tabs=editionTabs action="changeEdition" labelKey="ORDEMPARANORMAL2.AdventureImport.Title"}}
  <aside class="op2-adventure-import__notice">
    <p>{{localize "ORDEMPARANORMAL2.AdventureImport.Notice.Ownership"}}</p>
    <p>{{localize "ORDEMPARANORMAL2.AdventureImport.Notice.LocalProcessing"}}</p>
  </aside>

  {{#if showBeta}}
    {{> "systems/ordemparanormal2/templates/applications/adventure-import-beta.hbs" beta}}
  {{else}}
  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-main-heading">
    <h2 id="op2-adventure-import-main-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.MainMaterial"}}</h2>
    {{> "systems/ordemparanormal2/templates/applications/adventure-import-file-row.hbs" name=pdfName labelKey="ORDEMPARANORMAL2.AdventureImport.PlaytestPdf" slot="pdf" action="selectPdf" buttonKey="ORDEMPARANORMAL2.AdventureImport.Actions.SelectPdf" accept=".pdf" busy=isImporting}}
  </section>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-extras-heading">
    <h2 id="op2-adventure-import-extras-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.ExtrasByAct"}}</h2>
    <div class="op2-adventure-import__file-list">
      {{> "systems/ordemparanormal2/templates/applications/adventure-import-file-row.hbs" name=actOneName labelKey="ORDEMPARANORMAL2.AdventureImport.ActOne" slot="actOne" action="selectZip" buttonKey="ORDEMPARANORMAL2.AdventureImport.Actions.SelectZip" accept=".zip" busy=isImporting}}
      {{> "systems/ordemparanormal2/templates/applications/adventure-import-file-row.hbs" name=actTwoName labelKey="ORDEMPARANORMAL2.AdventureImport.ActTwo" slot="actTwo" action="selectZip" buttonKey="ORDEMPARANORMAL2.AdventureImport.Actions.SelectZip" accept=".zip" busy=isImporting}}
    </div>
  </section>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-as09-heading">
    <h2 id="op2-adventure-import-as09-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.As09.Label"}}</h2>
    <p class="op2-adventure-import__supplemental-note">{{localize "ORDEMPARANORMAL2.AdventureImport.As09.Description"}}</p>
    {{> "systems/ordemparanormal2/templates/applications/adventure-import-file-row.hbs" name=as09Name label="AS09-Extras-v1.0-Elite.zip" compact=true slot="as09" action="selectZip" buttonKey="ORDEMPARANORMAL2.AdventureImport.Actions.SelectZip" accept=".zip" busy=isImporting}}
    {{#if as09Name}}<button type="button" data-action="removeAs09" {{#if isImporting}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.AdventureImport.As09.Remove"}}</button>{{/if}}
    {{#with as09Status}}
      <div class="op2-adventure-import__status-row op2-adventure-import__status-row--{{modifier}}" role="status">
        <span class="op2-adventure-import__status-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
        <span class="op2-adventure-import__status-text"><span class="op2-adventure-import__status-value">{{text}}</span>{{#each issues}}<span class="op2-adventure-import__status-issue">{{this}}</span>{{/each}}</span>
      </div>
    {{/with}}
    {{#if as09Directory}}<p class="op2-adventure-import__asset-directory">{{localize "ORDEMPARANORMAL2.AdventureImport.As09.Directory"}} <code>{{as09Directory}}</code></p>{{/if}}
  </section>

  <section class="op2-adventure-import__section" aria-labelledby="op2-adventure-import-detected-heading">
    <h2 id="op2-adventure-import-detected-heading">{{localize "ORDEMPARANORMAL2.AdventureImport.DetectedContent"}}</h2>
    {{#if hasAnalysis}}
      <div class="op2-adventure-import__analysis">
        {{#with pdfStatus}}
          <div class="op2-adventure-import__status-row op2-adventure-import__status-row--{{modifier}}">
            <span class="op2-adventure-import__status-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
            <span class="op2-adventure-import__status-text">
              <span class="op2-adventure-import__status-label">{{label}}</span>
              <span class="op2-adventure-import__status-value">{{text}}</span>
              {{#each issues}}<span class="op2-adventure-import__status-issue">{{this}}</span>{{/each}}
            </span>
          </div>
        {{/with}}
        {{#if actCards.length}}
          <div class="op2-adventure-import__act-cards">
            {{#each actCards}}
              <article class="op2-adventure-import__act-card{{#if selected}} op2-adventure-import__act-card--selected{{/if}}" aria-label="{{label}}">
                <h3 class="op2-adventure-import__act-title">{{label}}</h3>
                <p class="op2-adventure-import__act-status"><i class="fa-solid {{#if selectable}}fa-check{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>{{status}}</p>
                <button type="button" data-action="toggleAct" data-act="{{act}}" aria-pressed="{{selected}}" {{#if ../isImporting}}disabled{{else}}{{#unless selectable}}disabled{{/unless}}{{/if}}>{{selectionLabel}}</button>
                {{#each issues}}<p class="op2-adventure-import__status-issue">{{this}}</p>{{/each}}
                <div class="op2-adventure-import__act-content">
                  {{#each content}}
                    <div class="op2-adventure-import__act-content-row">
                      <i class="op2-adventure-import__act-content-icon {{icon}}" aria-hidden="true"></i>
                      <span class="op2-adventure-import__act-content-label">{{label}}</span>
                      <span class="op2-adventure-import__act-content-count">{{count}}</span>
                    </div>
                  {{/each}}
                </div>
              </article>
            {{/each}}
          </div>
        {{/if}}
        {{#each otherStatuses}}
          <div class="op2-adventure-import__status-row op2-adventure-import__status-row--{{modifier}}">
            <span class="op2-adventure-import__status-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
            <span class="op2-adventure-import__status-text">
              <span class="op2-adventure-import__status-label">{{label}}</span>
              <span class="op2-adventure-import__status-value">{{text}}</span>
              {{#each issues}}<span class="op2-adventure-import__status-issue">{{this}}</span>{{/each}}
            </span>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="op2-adventure-import__empty-content">
        {{localize "ORDEMPARANORMAL2.AdventureImport.EmptyContent"}}
      </div>
    {{/if}}
  </section>

  {{#if completionWarnings.length}}
    <section class="op2-adventure-import__section" aria-label="{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.ImportWithWarnings"}}">
      <p>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.ImportWithWarnings"}}</p>
      <ul>{{#each completionWarnings}}<li>{{this}}</li>{{/each}}</ul>
    </section>
  {{/if}}

  <footer class="op2-adventure-import__actions">
    {{#if progress}}<p class="op2-adventure-import__progress" role="status" aria-live="polite">{{progress}}</p>{{/if}}
    <button type="button" data-action="analyzeFiles" {{#unless canAnalyze}}disabled{{/unless}}>{{localize "ORDEMPARANORMAL2.AdventureImport.Actions.Analyze"}}</button>
    <button type="button" data-action="importAssets" {{#unless canImport}}disabled{{/unless}}>{{importLabel}}</button>
  </footer>
  {{/if}}
</div>
