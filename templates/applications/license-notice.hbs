<section class="op2-license-notice__content">
  <figure class="op2-license-notice__branding">
    <img
      class="op2-license-notice__seal"
      src="{{sealPath}}"
      alt="{{localize 'ORDEMPARANORMAL2.LicenseNotice.SealAlt'}}"
    />
    <figcaption class="op2-license-notice__ai-warning">
      {{localize "ORDEMPARANORMAL2.LicenseNotice.AiWarning"}}
    </figcaption>
  </figure>

  <p class="op2-license-notice__statement">
    {{localize "ORDEMPARANORMAL2.LicenseNotice.Statement"}}
  </p>
  <p>{{localize "ORDEMPARANORMAL2.LicenseNotice.NoAffiliation"}}</p>
  <p>
    <a href="{{licenseUrl}}" target="_blank" rel="noopener noreferrer">
      {{localize "ORDEMPARANORMAL2.LicenseNotice.Actions.ViewLicense"}}
    </a>
  </p>

  <label class="op2-license-notice__preference">
    <input type="checkbox" name="doNotShowAgain" />
    <span>{{localize "ORDEMPARANORMAL2.LicenseNotice.DoNotShowAgain"}}</span>
  </label>
</section>
