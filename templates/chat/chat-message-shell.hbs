<div class="op2-chat-message__shell{{#unless portrait}} op2-chat-message__shell--no-portrait{{/unless}}" aria-label="{{speakerName}}">
  <div class="op2-chat-message__metadata-header">
    {{#if metadataHeader.authorName}}
      <span class="op2-chat-message__author" title="{{metadataHeader.authorName}}">{{metadataHeader.authorName}}</span>
    {{/if}}

    <div class="op2-chat-message__metadata-actions">
      {{#if metadataHeader.timestamp}}
        <time class="op2-chat-message__metadata">{{metadataHeader.timestamp}}</time>
      {{/if}}

      {{#if metadataHeader.canDelete}}
        <button
          class="op2-chat-message__delete"
          type="button"
          data-action="delete-message"
          aria-label="{{localize 'ORDEMPARANORMAL2.ChatMessage.Delete'}}"
          title="{{localize 'ORDEMPARANORMAL2.ChatMessage.Delete'}}"
        >
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
        </button>
      {{/if}}
    </div>
  </div>

  {{#if portrait}}
    <div class="op2-chat-message__portrait" role="img" aria-label="{{portrait.name}}" title="{{portrait.name}}">
      {{#if portrait.img}}
        <img src="{{portrait.img}}" alt="{{portrait.name}}" />
      {{else}}
        <i class="fa-solid fa-user" aria-hidden="true"></i>
      {{/if}}
    </div>
  {{/if}}

  {{#if header}}
    {{> chatCardHeader title=header.title subtitle=header.subtitle}}
  {{/if}}

  <div class="op2-chat-message__content">{{{content}}}</div>
</div>
