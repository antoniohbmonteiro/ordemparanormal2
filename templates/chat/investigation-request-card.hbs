<article class="op2-investigation-request-card">
  {{> chatCardHeader title=title subtitle=actorName}}
  {{#if receiverName}}<p>{{receiverName}}</p>{{/if}}
  {{#if text}}<p>{{text}}</p>{{/if}}
  <p role="status">{{status}}</p>
  {{#if pending}}<div data-investigation-request-actions></div>{{/if}}
</article>
