<article class="op2-opposed-check-card">
  {{> chatCardHeader title=title subtitle=subtitle}}

  <section class="op2-opposed-check-card__matchup" aria-label="{{localize 'ORDEMPARANORMAL2.OpposedCheckCard.Matchup'}}">
    <div class="op2-opposed-check-card__participant op2-opposed-check-card__participant--left">
      {{> opposedCheckPortrait name=left.name img=left.img variant="card"}}
      <strong class="op2-opposed-check-card__name" title="{{left.name}}">{{left.name}}</strong>
      <span class="op2-opposed-check-card__context" title="{{left.context}}">{{left.context}}</span>
      {{#if left.rolled}}
        <strong class="op2-opposed-check-card__total">{{left.total}}</strong>
        <div class="op2-opposed-check-card__analysis"><span>{{localize "ORDEMPARANORMAL2.CheckCard.HighestResult"}} <strong>{{left.highestResult}}</strong></span><span class="op2-opposed-check-card__analysis-separator">·</span><span>{{localize "ORDEMPARANORMAL2.CheckCard.LowestResult"}} <strong>{{left.lowestResult}}</strong></span></div>
      {{else}}
        <div class="op2-opposed-check-card__pending" data-opposed-side-actions="left"><span>{{localize "ORDEMPARANORMAL2.OpposedCheckCard.Awaiting"}}</span></div>
      {{/if}}
    </div>
    <div class="op2-opposed-check-card__versus" aria-label="{{localize 'ORDEMPARANORMAL2.OpposedCheckCard.Versus'}}"><span aria-hidden="true">{{localize "ORDEMPARANORMAL2.OpposedCheckCard.Versus"}}</span></div>
    <div class="op2-opposed-check-card__participant op2-opposed-check-card__participant--right">
      {{> opposedCheckPortrait name=right.name img=right.img variant="card"}}
      <strong class="op2-opposed-check-card__name" title="{{right.name}}">{{right.name}}</strong>
      <span class="op2-opposed-check-card__context" title="{{right.context}}">{{right.context}}</span>
      {{#if right.rolled}}
        <strong class="op2-opposed-check-card__total">{{right.total}}</strong>
        <div class="op2-opposed-check-card__analysis"><span>{{localize "ORDEMPARANORMAL2.CheckCard.HighestResult"}} <strong>{{right.highestResult}}</strong></span><span class="op2-opposed-check-card__analysis-separator">·</span><span>{{localize "ORDEMPARANORMAL2.CheckCard.LowestResult"}} <strong>{{right.lowestResult}}</strong></span></div>
      {{else}}
        <div class="op2-opposed-check-card__pending" data-opposed-side-actions="right"><span>{{localize "ORDEMPARANORMAL2.OpposedCheckCard.Awaiting"}}</span></div>
      {{/if}}
    </div>
  </section>

  {{#if winner}}
    <div class="op2-opposed-check-card__winner"><i class="fa-solid fa-trophy" aria-hidden="true"></i><strong>{{winner.name}} {{localize "ORDEMPARANORMAL2.OpposedCheckCard.Wins"}}</strong></div>
  {{else if (eq resolution "equalTotals")}}
    <div class="op2-opposed-check-card__equal"><strong>{{localize "ORDEMPARANORMAL2.OpposedCheckCard.EqualTotals"}}</strong></div>
  {{/if}}

  {{#if hasAnyResult}}
    <details class="op2-opposed-check-card__breakdown">
      <summary class="op2-opposed-check-card__summary">
        <span class="op2-opposed-check-card__formulas">
          {{#if left.rolled}}<span><strong title="{{left.name}}">{{left.name}}:</strong> <span>{{left.contributingFormula}}</span></span>{{/if}}
          {{#if right.rolled}}<span><strong title="{{right.name}}">{{right.name}}:</strong> <span>{{right.contributingFormula}}</span></span>{{/if}}
        </span>
        <i class="fa-solid fa-chevron-down op2-opposed-check-card__chevron" aria-hidden="true"></i>
      </summary>
      <div class="op2-opposed-check-card__details">
        {{#if left.rolled}}<section class="op2-opposed-check-card__dice-group"><h4 title="{{left.name}}">{{left.name}}</h4><ol>{{#each left.dice}}<li class="op2-opposed-check-card__die{{#unless contributes}} op2-opposed-check-card__die--excluded{{/unless}}"><span class="op2-opposed-check-card__die-label" title="{{label}}">{{label}}</span><span>{{dieLabel}}</span><strong>{{result}}</strong></li>{{/each}}</ol></section>{{/if}}
        {{#if right.rolled}}<section class="op2-opposed-check-card__dice-group"><h4 title="{{right.name}}">{{right.name}}</h4><ol>{{#each right.dice}}<li class="op2-opposed-check-card__die{{#unless contributes}} op2-opposed-check-card__die--excluded{{/unless}}"><span class="op2-opposed-check-card__die-label" title="{{label}}">{{label}}</span><span>{{dieLabel}}</span><strong>{{result}}</strong></li>{{/each}}</ol></section>{{/if}}
      </div>
    </details>
  {{/if}}
</article>
