<section class="op2-ability-sheet">
  <header class="op2-ability-sheet__header">
    <img class="op2-ability-sheet__image" src="{{ability.img}}" alt="{{localize 'ORDEMPARANORMAL2.AbilitySheet.Fields.Image'}}" data-edit="img" {{#if editable}}data-action="editImage"{{/if}} />
    <label class="op2-ability-sheet__name"><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.Name"}}</span><input type="text" name="name" value="{{ability.name}}" autocomplete="off"{{#unless editable}} disabled{{/unless}} /></label>
  </header>
  <nav class="op2-ability-sheet__tabs tabs" data-group="sheet" aria-label="{{localize 'ORDEMPARANORMAL2.AbilitySheet.Tabs.Label'}}">
    {{#each tabs}}<button class="{{cssClass}}" type="button" data-action="tab" data-tab="{{id}}" data-group="{{group}}" aria-pressed="{{active}}">{{localize label}}</button>{{/each}}
  </nav>
  <div class="op2-ability-sheet__body">
    <section class="tab {{tabs.general.cssClass}}" data-group="sheet" data-tab="general">
      <section class="op2-ability-sheet__description"><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.Description"}}</span><prose-mirror name="system.description" value="{{ability.description}}" toggled="true" document-uuid="{{ability.uuid}}"{{#unless editable}} disabled{{/unless}}>{{{ability.enrichedDescription}}}</prose-mirror></section>
      <section class="op2-ability-sheet__resource-section">
        <header class="op2-ability-sheet__toolbar"><h2>{{localize "ORDEMPARANORMAL2.AbilitySheet.Resource"}}</h2>{{#if editable}}{{#unless ability.resource}}<button type="button" data-action="addResource"><i class="fa-solid fa-plus"></i> {{localize "ORDEMPARANORMAL2.AbilitySheet.Actions.AddResource"}}</button>{{/unless}}{{/if}}</header>
        {{#if ability.resource}}
          <div class="op2-ability-sheet__resource"><label><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.Value"}}</span><input type="number" value="{{ability.resource.value}}" min="0" step="1" data-resource-edit data-resource-field="value"{{#unless editable}} disabled{{/unless}} /></label><label><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.Maximum"}}</span><input type="number" value="{{ability.resource.max}}" min="0" step="1" data-resource-edit data-resource-field="max"{{#unless editable}} disabled{{/unless}} /></label>{{#if editable}}<button class="op2-ability-sheet__remove" type="button" data-action="removeResource" title="{{localize 'ORDEMPARANORMAL2.AbilitySheet.Actions.RemoveResource'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}</div>
        {{else}}<p class="op2-ability-sheet__empty">{{localize "ORDEMPARANORMAL2.AbilitySheet.EmptyResource"}}</p>{{/if}}
      </section>
    </section>
    <section class="tab {{tabs.uses.cssClass}}" data-group="sheet" data-tab="uses">
      <header class="op2-ability-sheet__toolbar"><h2>{{localize "ORDEMPARANORMAL2.AbilitySheet.Uses"}}</h2>{{#if editable}}<button type="button" data-action="createUse"><i class="fa-solid fa-plus"></i> {{localize "ORDEMPARANORMAL2.AbilitySheet.Actions.CreateUse"}}</button>{{/if}}</header>
      {{#if ability.uses}}<div class="op2-ability-sheet__uses">{{#each ability.uses}}<button class="op2-ability-sheet__use" type="button" data-action="openUse" data-use-id="{{id}}"><span class="op2-ability-sheet__use-name">{{name}}</span><span class="op2-ability-sheet__use-cost">{{costLabel}}</span>{{#if hasMinimumLevel}}<span class="op2-ability-sheet__use-level">{{localize "ORDEMPARANORMAL2.AbilitySheet.Level" level=minimumLevel}}</span>{{/if}}</button>{{/each}}</div>{{else}}<p class="op2-ability-sheet__empty">{{localize "ORDEMPARANORMAL2.AbilitySheet.EmptyUses"}}</p>{{/if}}
    </section>
  </div>
</section>
