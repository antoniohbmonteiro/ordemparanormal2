<section class="op2-ability-use-editor">
  <div class="op2-ability-use-editor__body">
    <label class="op2-ability-use-editor__field"><span>{{localize "ORDEMPARANORMAL2.AbilityUseEditor.Fields.Name"}}</span><input type="text" name="name" value="{{draft.name}}" autocomplete="off"{{#if editable}} autofocus required{{else}} readonly{{/if}} /></label>
    <label class="op2-ability-use-editor__field op2-ability-use-editor__description"><span>{{localize "ORDEMPARANORMAL2.AbilityUseEditor.Fields.Description"}}</span><prose-mirror name="description" value="{{draft.description}}" toggled="true" document-uuid="{{abilityUuid}}"{{#unless editable}} disabled{{/unless}}>{{{enrichedDescription}}}</prose-mirror></label>
    <fieldset class="op2-ability-use-editor__cost"><legend>{{localize "ORDEMPARANORMAL2.AbilitySheet.Cost"}}</legend><label class="op2-ability-use-editor__field"><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.CostSource"}}</span><select name="costSource"{{#unless editable}} disabled{{/unless}}>{{#each sources}}<option value="{{value}}"{{#if selected}} selected{{/if}}{{#if disabled}} disabled{{/if}}>{{localize labelKey}}</option>{{/each}}</select></label><label class="op2-ability-use-editor__field"><span>{{localize "ORDEMPARANORMAL2.AbilitySheet.Fields.CostAmount"}}</span><input type="number" name="costAmount" value="{{draft.cost.amount}}" min="0" step="1" inputmode="numeric"{{#if editable}} required{{else}} readonly{{/if}} /></label></fieldset>
    {{#unless hasResource}}<p class="op2-ability-use-editor__hint">{{localize "ORDEMPARANORMAL2.AbilityUseEditor.ResourceHint"}}</p>{{/unless}}
    <label class="op2-ability-use-editor__field"><span>{{localize "ORDEMPARANORMAL2.AbilityUseEditor.Fields.MinimumLevel"}}</span><input type="number" name="minimumLevel" value="{{draft.minimumLevel}}" min="1" max="10" step="1" inputmode="numeric"{{#unless editable}} readonly{{/unless}} /></label>
  </div>
  <footer class="op2-ability-use-editor__actions">{{#if editable}}{{#unless isNew}}<button type="button" data-action="remove"><i class="fa-solid fa-trash"></i> {{localize "ORDEMPARANORMAL2.AbilityUseEditor.Actions.Remove"}}</button><button type="button" data-action="moveUp"{{#unless canMoveUp}} disabled{{/unless}} title="{{localize 'ORDEMPARANORMAL2.AbilityUseEditor.Actions.MoveUp'}}"><i class="fa-solid fa-arrow-up"></i></button><button type="button" data-action="moveDown"{{#unless canMoveDown}} disabled{{/unless}} title="{{localize 'ORDEMPARANORMAL2.AbilityUseEditor.Actions.MoveDown'}}"><i class="fa-solid fa-arrow-down"></i></button>{{/unless}}{{/if}}<span class="op2-ability-use-editor__spacer"></span><button type="button" data-action="cancel">{{localize "ORDEMPARANORMAL2.AbilityUseEditor.Actions.Cancel"}}</button>{{#if editable}}<button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "ORDEMPARANORMAL2.AbilityUseEditor.Actions.Save"}}</button>{{/if}}</footer>
</section>
