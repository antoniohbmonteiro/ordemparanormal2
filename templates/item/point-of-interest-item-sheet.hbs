<section class="op2-poi-sheet">
{{#if canViewAuthoring}}
  <header class="op2-poi-sheet__header">
    <img class="op2-poi-sheet__image" src="{{poi.img}}" alt="{{localize 'ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Image'}}" data-edit="img" {{#if editable}}data-action="editImage"{{/if}} />
    <label class="op2-poi-sheet__name">
      <span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Name"}}</span>
      <input type="text" name="name" value="{{poi.name}}" autocomplete="off"{{#unless editable}} disabled{{/unless}} />
    </label>
  </header>
  <div class="op2-poi-sheet__body">
    <section class="op2-poi-sheet__description">
      <span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.PublicDescription"}}</span>
      <prose-mirror name="system.publicDescription" value="{{poi.publicDescription}}" toggled="true" document-uuid="{{poi.uuid}}"{{#unless editable}} disabled{{/unless}}>{{{poi.enrichedPublicDescription}}}</prose-mirror>
    </section>
    <fieldset class="op2-poi-sheet__gm">
      <legend>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.GmContextLegend"}}</legend>
      <prose-mirror name="system.gmContext" value="{{poi.gmContext}}" toggled="true" document-uuid="{{poi.uuid}}"{{#unless editable}} disabled{{/unless}}>{{{poi.enrichedGmContext}}}</prose-mirror>
    </fieldset>
    <section class="op2-poi-sheet__information-section">
      <header class="op2-poi-sheet__toolbar">
        <h2>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Information"}}</h2>
        {{#if editable}}<button type="button" data-action="addInformation"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Actions.AddInformation"}}</button>{{/if}}
      </header>
      <div class="op2-poi-sheet__information-list">
        {{#each poi.information}}
          <section class="op2-poi-sheet__information-card" data-information-id="{{id}}">
            <header class="op2-poi-sheet__information-header">
              <h3>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Table.Information"}} {{displayIndex}}</h3>
              {{#if @root.editable}}<button type="button" class="op2-poi-sheet__remove" data-action="removeInformation" data-information-id="{{id}}" title="{{localize 'ORDEMPARANORMAL2.PointOfInterestSheet.Actions.RemoveInformation'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
            </header>
            <label class="op2-poi-sheet__content-label">
              <span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Table.Information"}}</span>
              <textarea rows="2" data-poi-edit="content" data-information-id="{{id}}"{{#unless @root.editable}} disabled{{/unless}}>{{content}}</textarea>
            </label>
            <div class="op2-poi-sheet__availability">
              <label><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Availability"}}</span>
                <select data-poi-edit="availability" data-information-id="{{id}}"{{#unless @root.editable}} disabled{{/unless}}>
                  {{#each availabilityOptions}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{localize label}}</option>{{/each}}
                </select>
              </label>
              {{#if showCondition}}
                <label class="op2-poi-sheet__condition"><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Condition"}}</span>
                  <input type="text" value="{{condition}}" autocomplete="off" data-poi-edit="condition" data-information-id="{{id}}"{{#unless @root.editable}} disabled{{/unless}} />
                </label>
              {{/if}}
            </div>
            <div class="op2-poi-sheet__approaches">
              <h4>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Approaches"}}</h4>
              {{#each approaches}}
                <div class="op2-poi-sheet__approach">
                  <label><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Skill"}}</span>
                    <select data-poi-edit="skill" data-information-id="{{../id}}" data-approach-index="{{index}}"{{#unless @root.editable}} disabled{{/unless}}>
                      {{#each skillOptions}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                  {{#if isAptitude}}
                    <label><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Fields.Specialization"}}</span>
                      <select data-poi-edit="specialization" data-information-id="{{../id}}" data-approach-index="{{index}}"{{#unless @root.editable}} disabled{{/unless}}>
                        {{#each specializationOptions}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
                      </select>
                    </label>
                  {{/if}}
                  <label class="op2-poi-sheet__difficulty"><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Table.Difficulty"}}</span>
                    <input type="number" min="1" step="1" inputmode="numeric" value="{{difficulty}}" data-poi-edit="difficulty" data-information-id="{{../id}}" data-approach-index="{{index}}"{{#unless @root.editable}} disabled{{/unless}} />
                  </label>
                  <label class="op2-poi-sheet__visibility"><input type="checkbox" data-poi-edit="showDifficultyToPlayers" data-information-id="{{../id}}" data-approach-index="{{index}}"{{#if showDifficultyToPlayers}} checked{{/if}}{{#unless @root.editable}} disabled{{/unless}} /><span>{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Table.ShowDifficulty"}}</span></label>
                  {{#if @root.editable}}<button type="button" class="op2-poi-sheet__remove" data-action="removeApproach" data-information-id="{{../id}}" data-approach-index="{{index}}" title="{{localize 'ORDEMPARANORMAL2.PointOfInterestSheet.Actions.RemoveApproach'}}"{{#unless ../canRemoveApproach}} disabled{{/unless}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
                </div>
              {{/each}}
              {{#if @root.editable}}<button type="button" class="op2-poi-sheet__add-approach" data-action="addApproach" data-information-id="{{id}}"{{#unless canAddApproach}} disabled{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "ORDEMPARANORMAL2.PointOfInterestSheet.Actions.AddApproach"}}</button>{{/if}}
            </div>
          </section>
        {{else}}<p class="op2-poi-sheet__empty">{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.EmptyInformation"}}</p>{{/each}}
      </div>
    </section>
  </div>
{{else}}
  <p class="op2-poi-sheet__gm-only">{{localize "ORDEMPARANORMAL2.PointOfInterestSheet.GmOnly"}}</p>
{{/if}}
</section>
