<div class="op2-radio-config">
  <fieldset><legend>{{localize "ORDEMPARANORMAL2.Radio.TrueFragments"}}</legend>
    <div data-radio-list="trueFragments"></div><button type="button" data-radio-edit="add" data-kind="trueFragments">{{localize "ORDEMPARANORMAL2.Radio.Add"}}</button>
  </fieldset>
  <fieldset><legend>{{localize "ORDEMPARANORMAL2.Radio.FalseFragments"}}</legend>
    <div data-radio-list="falseFragments"></div><button type="button" data-radio-edit="add" data-kind="falseFragments">{{localize "ORDEMPARANORMAL2.Radio.Add"}}</button>
  </fieldset>
  <strong>{{localize "ORDEMPARANORMAL2.Radio.Preview"}}</strong><p data-radio-preview></p><p data-radio-error role="status"></p>
</div>
