<section class="op2-investigation-body" role="document">
  {{#if isReady}}
    <header class="op2-investigation-summary">
      <figure class="op2-investigation-image">
        <span role="img" aria-label="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.NoImage'}}"><i class="fa-solid fa-image" aria-hidden="true"></i></span>
        {{#if img}}<img data-poi-image data-action="enlargeImage" src="{{img}}" alt="{{name}}" title="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.EnlargeImage'}}" aria-label="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.EnlargeImage'}}" />{{/if}}
      </figure>
      <div class="op2-investigation-intro">
        <h2>{{name}}</h2>
        {{#if description}}
          <div class="op2-investigation-description">{{{description}}}</div>
        {{/if}}
      </div>
    </header>

    <section class="op2-investigation-panel">
      <h3>{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.SkillsHeading"}}</h3>
      {{#if isPlayer}}
        <label class="op2-investigation-agent-label">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Agent"}}
          <select data-poi-agent>
            {{#unless canExamine}}<option value="" selected>{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.ChooseAgent"}}</option>{{/unless}}
            {{#each agents}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
      {{/if}}

      <div class="op2-investigation-table {{#if isPlayer}}is-player{{else}}is-gm{{/if}}" role="table" aria-label="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.SkillsHeading'}}">
        <div class="op2-investigation-table__header" role="row">
          <span role="columnheader">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Skill"}}</span>
          <span role="columnheader">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Action"}}</span>
          <span role="columnheader">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Difficulty"}}</span>
          <span role="columnheader">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Information"}}</span>
        </div>

        <div class="op2-investigation-table__body">
          {{#each skills}}
            <section class="op2-investigation-skill" role="rowgroup" data-skill="{{key}}" style="--op2-information-count: {{informationCount}}">
              {{#each information}}
                <div class="op2-investigation-row{{#if isFirst}} is-first{{/if}}" role="row">
                  {{#if isFirst}}
                    <div class="op2-investigation-skill-cell" role="rowheader">
                      <strong>{{../name}}</strong>
                    </div>
                  {{/if}}

                  {{#if @root.isPlayer}}
                    {{#if isFirst}}
                      <div class="op2-investigation-action" role="cell">
                        {{#if ../hasUndiscovered}}<button type="button" class="op2-investigation-examine" data-action="examine" data-skill="{{../key}}" aria-label="{{../examineLabel}}" title="{{../examineLabel}}" {{#unless @root.canExamine}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button>{{/if}}
                      </div>
                    {{/if}}
                  {{else}}
                    <div class="op2-investigation-action" role="cell">
                      <button type="button" class="op2-investigation-reveal" data-action="revealInformation" data-information-id="{{id}}" aria-label="{{revealLabel}}"><i class="fa-solid fa-eye" aria-hidden="true"></i> {{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Reveal"}}</button>
                      {{#if knownCount}}<span class="op2-investigation-revealed">{{knownCount}} {{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.AgentsKnow"}}</span>{{/if}}
                    </div>
                  {{/if}}

                  <div class="op2-investigation-difficulty" role="cell">
                    {{#if @root.isGm}}
                      <span>{{difficulty}}</span>
                      {{#if isDifficultyHidden}}
                        <span class="op2-investigation-gm-hidden-difficulty" title="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.HiddenDifficultyToPlayers'}}" role="img" aria-label="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.HiddenDifficultyToPlayers'}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i></span>
                      {{/if}}
                    {{else}}
                      {{#if isHidden}}
                        <span title="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.HiddenDifficulty'}}" role="img" aria-label="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.HiddenDifficulty'}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i></span>
                      {{else}}
                        {{difficulty}}
                      {{/if}}
                    {{/if}}
                  </div>

                  <div class="op2-investigation-information" role="cell">
                    {{#if specializationLabel}}<strong class="op2-investigation-specialization">{{specializationLabel}}</strong>{{/if}}
                    {{#if isSituational}}
                      <p class="op2-investigation-situational"><span class="op2-investigation-situational__badge">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Situational"}}</span> <span class="op2-investigation-situational__condition">{{condition}}</span></p>
                    {{/if}}
                    <div class="op2-investigation-information__content">{{#if @root.isGm}}{{content}}{{else}}{{#if isRevealed}}{{content}}{{else}}{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.NoInformation"}}{{/if}}{{/if}}</div>
                  </div>
                </div>
              {{/each}}
            </section>
          {{else}}
            <p class="op2-investigation-empty">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.NoSkills"}}</p>
          {{/each}}
        </div>
      </div>

      {{#if isPlayer}}
        <button type="button" class="op2-investigation-other" disabled title="{{localize 'ORDEMPARANORMAL2.PointOfInterest.Investigation.UnavailableOtherSkill'}}">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.OtherSkill"}}</button>
      {{/if}}
    </section>

    {{#if isGm}}
      <aside class="op2-investigation-gm-context">
        <h3>{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.GmContext"}}</h3>
        {{#if gmContext}}
          <div class="op2-investigation-gm-context__content">{{{gmContext}}}</div>
        {{else}}
          <p class="op2-investigation-empty">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.EmptyGmContext"}}</p>
        {{/if}}
      </aside>
    {{/if}}
  {{else}}
    <h2>{{name}}</h2>
    <p role="status">{{message}}</p>
  {{/if}}
</section>
