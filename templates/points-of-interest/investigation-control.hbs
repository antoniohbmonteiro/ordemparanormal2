<section class="op2-investigation-control__body">
  <header class="op2-investigation-control__title">
    <p>{{sceneName}} — {{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.SkillsHeading"}}</p>
    <h2>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Title"}}</h2>
  </header>
  {{#if loading}}
    <p role="status">{{localize "ORDEMPARANORMAL2.PointOfInterest.Investigation.Loading"}}</p>
  {{else}}
    {{#if active}}
      <h3 class="op2-investigation-section-header">{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Round"}} {{round}}</h3>
      <section class="op2-investigation-control__panel">
        <ul class="op2-investigation-control__agents">
          {{#each participants}}
            <li data-agent-uuid="{{uuid}}">
              <button type="button" class="op2-investigation-control__agent-row" data-action="acted" aria-pressed="{{acted}}" {{#if @root.busy}}disabled{{/if}}>
                <span class="op2-investigation-control__agent-name">{{#if acted}}✓{{else}}○{{/if}} &nbsp;{{name}}</span>
                <span>{{#if acted}}{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.ActedStatus"}}{{else}}{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.PendingStatus"}}{{/if}}</span>
              </button>
            </li>
          {{else}}
            <li>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.NoAgents"}}</li>
          {{/each}}
        </ul>
      </section>
      <div class="op2-investigation-control__progress">
        <div><span>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Progress"}}</span><strong>{{actedCount}} / {{total}} {{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Acted"}}</strong></div>
        <div class="op2-investigation-control__progress-track"><span style="width: {{progressPercent}}%"></span></div>
      </div>
      <button type="button" class="op2-investigation-button op2-investigation-button--primary" data-action="advance" {{#if busy}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.NextRound"}}</button>
      <h3 class="op2-investigation-control__actions-title">{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.SceneActions"}}</h3>
      <div class="op2-investigation-control__uses">
        <button type="button" class="op2-investigation-button" data-action="recap" {{#if recapUsed}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Recap"}}</button>
        <button type="button" class="op2-investigation-button" data-action="share" {{#if shareUsed}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Share"}}</button>
      </div>
      <button type="button" class="op2-investigation-button" data-action="createClue">{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.CreateClue"}}</button>
      <button type="button" class="op2-investigation-control__end" data-action="end" {{#if busy}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.End"}}</button>
    {{else}}
      <p>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Inactive"}}</p>
      <button type="button" class="op2-investigation-button op2-investigation-button--primary" data-action="start" {{#if busy}}disabled{{/if}}>{{localize "ORDEMPARANORMAL2.PointOfInterest.InvestigationControl.Start"}}</button>
    {{/if}}
  {{/if}}
</section>
