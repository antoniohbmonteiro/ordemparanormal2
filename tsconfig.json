{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@common/*": ["./node_modules/@dfreds/foundry-types/common/*"],
      "@client/*": ["./node_modules/@dfreds/foundry-types/client/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
